##########################################################################
# Go Deep Africa Safari — environment configuration
# Copy to `.env` and fill in real values. Never commit the real .env.
##########################################################################

APP_NAME="Go Deep Africa Safari"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://godeepafricasafari.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

#-------------------------------------------------------------------------
# Database — cPanel MySQL (Home » MySQL Databases)
#-------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_godeepafrica
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

#-------------------------------------------------------------------------
# Sessions / cache / queue
#-------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

#-------------------------------------------------------------------------
# Mail — cPanel webmail (Email Accounts » Connect Devices)
#
# IMPORTANT (found 2026-08-25): do NOT point MAIL_HOST at
# mail.godeepafricasafari.com while that DNS record is proxied by Cloudflare.
# It currently resolves to Cloudflare edge IPs (188.114.96.6/188.114.97.6),
# and Cloudflare only proxies HTTP(S) — it does not proxy SMTP. The TCP
# connection to :465 is accepted but no SMTP banner ever arrives, so every
# booking notification silently fails. Verify with:
#     openssl s_client -connect mail.godeepafricasafari.com:465
#   -> no "220 ... ESMTP Exim" banner  = still proxied, mail will NOT send
#
# The app runs on the same cPanel server as Exim, so the most reliable option
# is to hand mail straight to the local mail server. No DNS, no TLS, no
# Cloudflare in the path:
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_ENCRYPTION=null
MAIL_USERNAME=info@godeepafricasafari.com
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="info@godeepafricasafari.com"
MAIL_FROM_NAME="${APP_NAME}"

# Alternative, once the `mail` record is set to "DNS only" (grey cloud) in
# Cloudflare so it resolves to the real server 194.163.187.10 (r1.netpoa.com).
# The server's cert covers *.godeepafricasafari.com, so SSL validates cleanly:
#   MAIL_HOST=mail.godeepafricasafari.com
#   MAIL_PORT=465
#   MAIL_ENCRYPTION=ssl

# Address that receives booking/enquiry notifications.
MAIL_ADMIN_ADDRESS="info@godeepafricasafari.com"

# Every inbox notified the moment a booking is submitted (comma separated).
# This list REPLACES the default, so include every address you want notified.
MAIL_BOOKING_RECIPIENTS="info@godeepafricasafari.com,exaudlaizer501@gmail.com,marosimon08@gmail.com"

#-------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection on the booking/inquiry forms)
#-------------------------------------------------------------------------
# Get both keys from the Cloudflare dashboard: Turnstile > Add site.
# Leave blank to disable Turnstile (forms still work, just without it).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

#-------------------------------------------------------------------------
# Dynamic content translation (see config/translation.php)
#-------------------------------------------------------------------------
# Serve the baked/cached translations only — no external API is contacted.
TRANSLATION_ENABLED=true
TRANSLATION_API_ENABLED=false
TRANSLATION_SEED_WARM=false
# The settings below only apply if you turn TRANSLATION_API_ENABLED=on to
# (re)generate translations offline; leave them commented for normal running.
# TRANSLATION_DRIVER=mymemory
# TRANSLATION_TIMEOUT=4
# MYMEMORY_EMAIL=info@godeepafricasafari.com
# DEEPL_KEY=

VITE_APP_NAME="${APP_NAME}"
